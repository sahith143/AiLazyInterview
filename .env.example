# Angel AI Assistant - Environment Configuration Example
# Copy this file to .env and fill in your values for local development

# API Provider Selection
# Options: gemini, openai
VITE_API_PROVIDER=gemini

# API Keys (not recommended to add here for security reasons)
# Instead, use the Settings modal in the app to configure API keys
# VITE_API_KEY_GEMINI=
# VITE_API_KEY_OPENAI=

# Development Settings
VITE_DEBUG=false
VITE_LOG_LEVEL=info

# Feature Flags (for experimental features)
VITE_ENABLE_EXPERIMENTAL_FEATURES=false
