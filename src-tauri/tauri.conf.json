{
  "build": {
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Angel AI Assistant",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": false, "open": true },
      "window": {
        "all": false,
        "create": true,
        "hide": true,
        "show": true,
        "minimize": true,
        "maximize": true,
        "unmaximize": true,
        "close": true,
        "setSkipTaskbar": true,
        "setAlwaysOnTop": true,
        "setDecorations": true,
        "setFocus": true,
        "setPosition": true,
        "setSize": true,
        "setVisible": true 
      },
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "https://generativelanguage.googleapis.com/*",
          "https://api.openai.com/*",
          "https://*.supabase.co/*"
        ]
      },
      "globalShortcut": { "all": true },
      "notification": { "all": true },
      "clipboard": { "all": true },
      "protocol": { "all": true, "asset": true, "assetScope": ["**"] }
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "Angel AI Assistant",
        "width": 800,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://generativelanguage.googleapis.com https://api.openai.com https://*.supabase.co; media-src 'self' blob:; img-src 'self' data:; frame-src 'self';"
    }
  }
}