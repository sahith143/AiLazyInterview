{
  "build": {
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Angel AI Assistant",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": false, "open": true },
      "window": {
        "all": false,
        "create": true,
        "hide": true,
        "show": true,
        "minimize": true,
        "maximize": true,
        "close": true,
        "startDragging": true,
        "setAlwaysOnTop": true,
        "setFocus": true
      },
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "https://generativelanguage.googleapis.com/*",
          "https://api.openai.com/*"
        ]
      },
      "globalShortcut": { "all": true }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.angel.assistant",
      "icon": ["icons/icon.ico", "icons/icon.png"]
    },
    "windows": [
      {
        "title": "Angel AI Assistant",
        "width": 400,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://generativelanguage.googleapis.com https://api.openai.com; img-src 'self' data:;"
    }
  }
}